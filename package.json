{
  "name": "maricopa-senior-living",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "check:format": "biome check .",
    "check:types": "turbo run check:types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@maricopa-senior-living/typescript-config": "workspace:*",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  }
}
