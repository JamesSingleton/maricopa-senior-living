{
  "name": "@maricopa-senior-living/studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract --enforce-required-fields",
    "check-types": "tsc --noEmit",
    "check": "npm run lint && npm run format && npm run check-types",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "type": "sanity schema extract --enforce-required-fields && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/assist": "^5.0.0",
    "@sanity/client": "^7.12.0",
    "@sanity/functions": "^1.0.3",
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.1.8",
    "@sanity/vision": "^4.10.2",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^4.10.2",
    "sanity-plugin-media": "^4.0.0",
    "slugify": "^1.6.6",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.3.0",
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
