    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "sanity-plugin-media": "^4.3.1",
    "slugify": "^1.6.9",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.20.1",
