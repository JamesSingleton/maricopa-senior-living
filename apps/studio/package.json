{
  "name": "@maricopa-senior-living/studio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract --enforce-required-fields",
    "check-types": "tsc --noEmit",
    "check": "npm run lint && npm run format && npm run check-types",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "type": "sanity schema extract --enforce-required-fields && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/assist": "^5.0.4",
    "@sanity/client": "catalog:",
    "@sanity/functions": "^1.2.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/orderable-document-list": "^1.5.0",
    "@sanity/ui": "^3.1.11",
    "@sanity/vision": "^5.8.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "^5.8.1",
    "sanity-plugin-lucide-icon-picker": "^1.0.3",
    "sanity-plugin-media": "^4.1.0",
    "slugify": "^1.6.6",
    "styled-components": "^6.3.9"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.11.0",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.54.0"
  }
}
