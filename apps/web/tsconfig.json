{
  "extends": "@maricopa-senior-living/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@maricopa-senior-living/ui/*": ["../../packages/ui/src/*"],
      "@maricopa-senior-living/sanity/*": ["../../packages/sanity/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
