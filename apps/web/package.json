{
  "name": "@maricopa-senior-living/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "git clean -xdf .next .turbo node_modules",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:types": "tsc --noEmit",
    "deploy:schema": "sanity schema deploy --manifest-dir public/admin/static",
    "deploy": "sanity deploy",
    "type": "sanity schema extract --enforce-required-fields && sanity typegen generate"
  },
  "dependencies": {
    "@maricopa-senior-living/env": "workspace:*",
    "@maricopa-senior-living/sanity": "workspace:*",
    "@maricopa-senior-living/ui": "workspace:*",
    "@portabletext/react": "^8.0.1",
    "lucide-react": "catalog:",
    "next": "^16.4.5",
    "next-plausible": "^4.0.0",
    "next-sanity": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "sanity-image": "^1.3.0"
  },
  "devDependencies": {
    "@maricopa-senior-living/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "catalog:"
  }
