{
  "name": "@maricopa-senior-living/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "git clean -xdf .next .turbo node_modules",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:types": "tsc --noEmit",
    "deploy:schema": "sanity schema deploy --manifest-dir public/admin/static",
    "deploy": "sanity deploy",
    "type": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "blueprints:deploy": "npx sanity@latest blueprints deploy",
    "blueprints:plan": "npx sanity@latest blueprints plan"
  },
  "dependencies": {
    "@maricopa-senior-living/env": "workspace:*",
    "@maricopa-senior-living/sanity": "workspace:*",
    "@maricopa-senior-living/ui": "workspace:*",
    "@portabletext/react": "^7.0.1",
    "lucide-react": "catalog:",
    "next": "^16.3.5",
    "next-plausible": "^4.0.0",
    "next-sanity": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "sanity-image": "^1.2.0"
  },
  "devDependencies": {
    "@maricopa-senior-living/typescript-config": "workspace:*",
    "@sanity/blueprints": "^0.23.6",
    "@sanity/functions": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:"
  }
}
